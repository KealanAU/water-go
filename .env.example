# Copy to .env and fill in your NVE HydAPI key (https://hydapi.nve.no).
NVE_API_KEY=
NVE_BASE_URL=https://hydapi.nve.no/api/v1
NVE_MAX_RETRIES=3
NVE_RATE_LIMIT=5
NVE_TIMEOUT=30s

# Database (local docker-compose default).
DATABASE_URL=postgres://water:water@localhost:5432/water?sslmode=disable

# Pipeline tuning.
POLL_INTERVAL=5m
# Comma-separated NVE station ids to poll.
STATION_IDS=2.32.0
MAX_STATIONS=25
# Parameters: 1000=water level, 1001=discharge, 1003=water temperature.
PARAMETERS=1000,1001,1003
# Resolution in minutes: 0=instantaneous, 60=hourly, 1440=daily.
RESOLUTION_TIME=60
# How far back each poll requests observations (Go duration).
LOOKBACK=24h

# API.
API_ADDR=:8080
# Comma-separated keys. Empty means public data API; set this outside local demos.
API_KEYS=
API_RATE_LIMIT=10
API_RATE_BURST=20
API_DEFAULT_PAGE_SIZE=500
API_MAX_PAGE_SIZE=5000

# Metrics / alerting.
METRICS_ADDR=:9090
ANOMALY_THRESHOLD=3
ANOMALY_WINDOW=100
ALERT_WEBHOOK_URL=
